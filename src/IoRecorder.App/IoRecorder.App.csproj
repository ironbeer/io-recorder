<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>IORecorder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(SmokeBuild)'=='true'">app.smoke.manifest</ApplicationManifest>
    <!-- Generated by scripts\make-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../IoRecorder.Core/IoRecorder.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="app.ico" /></ItemGroup>
  <!-- Bundled sample configurations; the app copies them into Documents\IORecorder\Configs on first start. -->
  <ItemGroup><None Include="..\..\samples\*.json" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>

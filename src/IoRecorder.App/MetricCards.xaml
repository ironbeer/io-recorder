<UserControl x:Class="IoRecorder.App.MetricCards" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IoRecorder.App">
  <UniformGrid Columns="4">
    <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="ReadLabel" Text="READ / MiB/s" Foreground="#91A6C5" FontSize="10"/><local:HelpMark Text="アプリが読み込んだ量（ページングI/Oを除く）。計測中は直近1秒の値、記録では記録全体の平均（合計 ÷ 記録の長さ）。&#10;最大は、1秒ごとの集計で最も多かった秒の値。" Width="14" Height="14"/></StackPanel><TextBlock x:Name="ReadValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#79ABFF"/><TextBlock x:Name="ReadDetail" Text="" Foreground="#91A6C5" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="WriteLabel" Text="WRITE / MiB/s" Foreground="#91A6C5" FontSize="10"/><local:HelpMark Text="アプリが書き込んだ量（ページングI/Oを除く）。計測中は直近1秒の値、記録では記録全体の平均（合計 ÷ 記録の長さ）。&#10;最大は、1秒ごとの集計で最も多かった秒の値。" Width="14" Height="14"/></StackPanel><TextBlock x:Name="WriteValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#65DDC8"/><TextBlock x:Name="WriteDetail" Text="" Foreground="#91A6C5" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="IopsLabel" Text="READ + WRITE / IOPS" Foreground="#91A6C5" FontSize="10"/><local:HelpMark Text="アプリのRead・Writeの回数（1秒あたり、ページングI/Oを除く）。ファイルを開く・閉じる・属性の照会などは含みません。" Width="14" Height="14"/></StackPanel><TextBlock x:Name="IopsValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="IopsDetail" Text="" Foreground="#91A6C5" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="LatencyLabel" Text="P95 LATENCY / ms" Foreground="#91A6C5" FontSize="10"/><local:HelpMark Text="成功したRead・Writeが、ファイルシステムに届いてから完了するまでの時間（ETWで記録、ページングI/Oを除く）。&#10;P95は、95%の要求がこの時間以内に終わったという意味。値は最大5%幅の区切りの上限値。計測中は計測開始からの値。" Width="14" Height="14"/></StackPanel><TextBlock x:Name="LatencyValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="LatencyDetail" Text="" Foreground="#91A6C5" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
  </UniformGrid>
</UserControl>

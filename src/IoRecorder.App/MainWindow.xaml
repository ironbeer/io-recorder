<Window x:Class="IoRecorder.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IoRecorder.App" Title="IO Recorder — ファイルI/O 計測・リプレイ・ベンチマーク" Icon="app.ico" Width="1440" Height="980" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="#EDF3FC">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101A29" BorderBrush="#26334A" BorderThickness="0,0,1,0">
      <Grid Margin="20,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Border Background="#65DDC8" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left"><TextBlock Text="IO" FontSize="21" FontWeight="Bold" Foreground="#0A2923" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="IO RECORDER" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,5"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="-5,35,-5,0"><Button x:Name="NavRecord" Content="01   ライブ計測" Style="{StaticResource Nav}" Click="ShowRecord"/><Button x:Name="NavResults" Content="02   記録を開く" Style="{StaticResource Nav}" Click="ShowResults"/><Button x:Name="NavReplay" Content="03   記録の再生" Style="{StaticResource Nav}" Click="ShowReplay"/><Button x:Name="NavBench" Content="04   ベンチマーク" Style="{StaticResource Nav}" Click="ShowBench"/><Button x:Name="NavCompare" Content="05   比較" Style="{StaticResource Nav}" Click="ShowCompare"/></StackPanel>
        <StackPanel Grid.Row="3"><Border Background="#17283A" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="WINDOWS ETW" FontSize="10" Foreground="#65DDC8"/><TextBlock x:Name="AdminStatus" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="記録するのはI/Oの振る舞い。&#10;元ファイルの内容は保存しません。" TextWrapping="Wrap" FontSize="11" Foreground="#90A2BD" Margin="0,10,0,0"/></StackPanel></Border><Border Background="#17283A" CornerRadius="7" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="保存先（記録・レポート・設定）" FontSize="10" Foreground="#65DDC8"/><TextBlock x:Name="StorageText" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="フォルダを開く" Padding="8,5" Margin="0,8,0,0" Click="OpenStorage"/></StackPanel></Border><TextBlock x:Name="VersionText" FontSize="10" Foreground="#657B9B" Margin="0,15,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><StackPanel><TextBlock x:Name="PageTitle" Text="ライブ計測" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,4"/><TextBlock x:Name="PageSubtitle" Text="" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StatusBadge" Text="●  READY" Foreground="#65DDC8" FontSize="12" HorizontalAlignment="Right"/><TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="23" HorizontalAlignment="Right" Margin="0,8,0,0"/></StackPanel></Grid>

      <Grid x:Name="RecordPanel" Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="295"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CaptureSettings">
          <TextBlock Text="計測の設定" FontSize="17" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="計測対象のアプリケーション" Style="{StaticResource Caption}"/><local:HelpMark Margin="4,7,0,0" Text="インストール済みのアプリか、実行中のプロセスから選びます。選んだアプリのプログラムと、そのアプリが起動したプロセス（子・孫）、同じフォルダにあるプログラムのI/Oを記録します。&#10;「計測を始めたら、このアプリを起動する」がオンなら、記録を始めてからアプリを起動するので、起動したときの読み込み（前回のプロジェクトや素材の一覧など）も記録に入ります。アプリは管理者ではない、ふだんの権限で起動します。&#10;作業の途中でアプリが落ちて、いつもの方法で起動し直しても、記録は続きます。"/></StackPanel>
          <Border Background="{StaticResource Input}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,8"><DockPanel><Image x:Name="AppIcon" Width="24" Height="24" Margin="0,0,10,0" DockPanel.Dock="Left" VerticalAlignment="Center" Visibility="Collapsed"/><TextBlock x:Name="AppText" Text="未選択" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
          <Button x:Name="AppButton" Content="アプリを選ぶ…" Padding="10,7" Margin="0,6,0,0" HorizontalAlignment="Left" Click="AppButtonClick"/>
          <CheckBox x:Name="LaunchBox" IsChecked="True" IsEnabled="False" Content="計測を始めたら、このアプリを起動する" Margin="0,8,0,0" Checked="LaunchChanged" Unchecked="LaunchChanged"/>
          <TextBlock Text="アプリを閉じた状態で「計測を開始」を押してください。" TextWrapping="Wrap" FontSize="11" Foreground="#8498B8" Margin="0,6,0,0"/>
          <TextBlock Text="対象フォルダ / ドライブ（任意・1行に1つ）" Style="{StaticResource Caption}"/>
          <TextBox x:Name="RootsBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Tag="例: L:\Production または \\server\share"/>
          <Button Content="対象フォルダを追加…" Margin="0,6,0,0" Click="BrowseRoot"/>
          <TextBlock Text="アプリとフォルダの両方を指定すると、アプリのI/O（どこへのものでも）と、フォルダへのI/O（どのプログラムのものでも）の両方を記録します。" TextWrapping="Wrap" FontSize="11" Foreground="#8498B8" Margin="0,9,0,0"/>
          <TextBlock Text="試験ラベル（任意・記録の見分け用メモ）" Style="{StaticResource Caption}"/><TextBox x:Name="LabelBox" ToolTip="HTMLレポートの見出しと「記録を開く」の概要に表示されます。計測の動作には影響しません。"/>
          <TextBlock Text="記録の保存先" Style="{StaticResource Caption}"/><TextBlock x:Name="RecordDestination" TextWrapping="Wrap" FontSize="12" Foreground="#B7C8E0"/>
          <TextBlock Text="LucidLinkの統計も同時に記録（任意）" Style="{StaticResource Caption}"/><TextBox x:Name="LucidBox" Tag="lucid.exe の場所（空欄なら記録しない）" ToolTip="記録中に lucid perf --all --seconds 1 を実行し、出力を lucidlink.jsonl に保存します。"/>
          <TextBlock Text="LucidLinkのインスタンスID（複数動かしている場合のみ）" Style="{StaticResource Caption}"/><TextBox x:Name="LucidIdBox" Tag="空欄なら既定のインスタンス" ToolTip="lucid list で確認できます。lucid --id &lt;ID&gt; perf … として渡します。"/>
          <Button x:Name="StartButton" Content="●  計測を開始" Style="{StaticResource Primary}" Margin="0,20,0,0" Click="StartRecording"/>
          <Button x:Name="StopButton" Content="■  停止して保存" IsEnabled="False" Background="#4D2836" BorderBrush="#7C4051" Margin="0,8,0,0" Click="StopWork"/>
          <Button x:Name="ExportRecordButton" Content="記録をzipで書き出す…" IsEnabled="False" Margin="0,8,0,0" Click="ExportLastRecording" ToolTip="いま保存した記録を1つのzipにまとめて、選んだフォルダに保存します（送る用）。受け取った側は、02の「zipから取り込む…」で開けます。"/>
        </StackPanel></ScrollViewer></Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <local:MetricCards x:Name="LiveCards" Height="120"/>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0" Height="520"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="時間ごとの推移" FontWeight="SemiBold"/><local:HelpMark Text="1秒ごとの集計。上から転送量（MiB/s）、IOPS、レイテンシP95（その秒に始まった成功Read/WriteのP95、対数目盛）。&#10;I/Oのない秒は線が切れ、前後にI/Oがない1秒だけの値は点で表示します。3段の時間軸は共通で、カーソルを重ねると各段にその秒の値が出ます。"/></StackPanel><TextBlock Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right"><Run Text="●" Foreground="#74A8FF"/><Run Text=" Read     "/><Run Text="●" Foreground="#65DDC8"/><Run Text=" Write     ／ 直近2分・約1秒更新"/></TextBlock></Grid><local:GraphControl x:Name="LiveGraph" Grid.Row="1" Margin="0,12,0,0"/></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" Height="400"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="18,14"><TextBlock Text="アクセス量の多いファイル" FontWeight="SemiBold"/><TextBlock x:Name="FileCountText" Text="0 files" Foreground="#91A6C5" HorizontalAlignment="Right" FontSize="11"/></Grid><DataGrid x:Name="LiveFiles" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Read" Binding="{Binding Reads,StringFormat=N0}" Width="70"/><DataGridTextColumn Header="Write" Binding="{Binding Writes,StringFormat=N0}" Width="70"/><DataGridTextColumn Header="MiB" Binding="{Binding TotalMiB,StringFormat=N1}" Width="70"/></DataGrid.Columns></DataGrid></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OSメモリ / 使用可能" FontSize="11" Foreground="#91A6C5"/><TextBlock x:Name="MemoryText" Text="—" FontSize="23" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="計測の品質" FontSize="11" Foreground="#91A6C5"/><TextBlock x:Name="QualityText" Text="計測待機中" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/></StackPanel></Grid></Border>
        </StackPanel></ScrollViewer>
      </Grid>

      <Grid x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SessionBox" IsReadOnly="True" ToolTip="選択中の記録"/><Button Grid.Column="1" Content="記録を開く…" Click="OpenSession" Margin="8,0,0,0"/><Button Grid.Column="2" Content="zipから取り込む…" Click="ImportArchive" Margin="8,0,0,0" ToolTip="「記録をzipで書き出す」で作ったzipを、保存先（Recordings）に展開して開きます"/><Button Grid.Column="3" Content="zipで書き出す…" Click="ExportOpenRecord" Margin="8,0,0,0" ToolTip="この記録を1つのzipにまとめて、選んだフォルダに保存します（送る用）"/><Button Grid.Column="4" Content="HTMLレポートを開く" Click="OpenReport" Margin="8,0,0,0"/><Button Grid.Column="5" Content="CSVを書き出す" Click="ExportCsv" Margin="8,0,0,0" ToolTip="全イベントを events.csv に書き出します（記録と同じくらいの大きさになります。場所の絞り込みに関係なく、記録の全部です）"/></Grid>
        <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
        <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock x:Name="SummaryText" Text="「記録を開く…」で、保存済みの記録を選んでください。" TextWrapping="Wrap" FontSize="15"/><TextBlock x:Name="SummaryQuality" Text="" TextWrapping="Wrap" Foreground="#91A6C5" FontSize="11" Margin="0,6,0,0"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="場所で絞り込む…" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center" Click="ChooseLocations" ToolTip="記録がI/Oを出したフォルダから選び、その中のI/Oだけで、02の集計・03のダミー生成と再生・05の比較を行います（記録に保存します）"/><TextBlock x:Name="LocationText" Text="" TextWrapping="Wrap" Foreground="#65DDC8" FontSize="11" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
        <local:MetricCards x:Name="ResultCards" Height="120" Margin="0,14,0,0"/>
        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0" Height="520"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="時間ごとの推移" FontWeight="SemiBold"/><local:HelpMark Text="1秒ごとの集計。上から転送量（MiB/s）、IOPS、レイテンシP95（その秒に始まった成功Read/WriteのP95、対数目盛）。&#10;I/Oのない秒は線が切れ、前後にI/Oがない1秒だけの値は点で表示します。3段の時間軸は共通で、カーソルを重ねると各段にその秒の値が出ます。"/></StackPanel><TextBlock Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right"><Run Text="●" Foreground="#74A8FF"/><Run Text=" Read     "/><Run Text="●" Foreground="#65DDC8"/><Run Text=" Write     ／ 1秒ごと・記録全体"/></TextBlock></Grid><local:GraphControl x:Name="ResultGraph" Grid.Row="1" Margin="0,12,0,0" EmptyText="記録を開くとグラフを表示します"/></Grid></Border>
        <Grid Margin="0,16,0,0" Height="480"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ファイルごとのアクセス" Margin="16,14" FontWeight="SemiBold"/><DataGrid x:Name="ResultFiles" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Read" Binding="{Binding Reads,StringFormat=N0}" Width="65"/><DataGridTextColumn Header="MiB" Binding="{Binding TotalMiB,StringFormat=N1}" Width="65"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="12"><Button DockPanel.Dock="Right" Content="検索" Click="SearchEvents" Padding="10,7" Margin="8,0,0,0"/><TextBox x:Name="EventFilter" Tag="パス・プロセス名・操作名で検索"/></DockPanel><DataGrid x:Name="EventGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="秒" Binding="{Binding Seconds,StringFormat=N3}" Width="65"/><DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="95"/><DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="bytes" Binding="{Binding Bytes,StringFormat=N0}" Width="75"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="一致する直近2,000件を表示。全件は events.jsonl、または「CSVを書き出す」で確認。" FontSize="10" Foreground="#91A6C5" Margin="12,8"/></Grid></Border></Grid>
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" Height="460"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="18,14,18,10"><StackPanel Orientation="Horizontal"><TextBlock Text="ファイルごとの読み方" FontWeight="SemiBold"/><local:HelpMark x:Name="PatternHelp" Text="アプリの要求（ページングI/Oを除く）から、ファイルごとに「どこを・どの大きさで・どの順に」読んだかをまとめた一覧です。読み込み量の多い順に最大1,000件。&#10;メモリに割り当てて読む方式（mmap）のファイルは、ページングI/Oとしてだけ記録されるので出ません。&#10;全ファイルの値は、記録フォルダの access-patterns.csv にあります。"/></StackPanel><TextBlock x:Name="ShapeSummary" Text="" Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          <DataGrid x:Name="PatternGrid" Grid.Row="1"><DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Shape}" Width="120"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="型"/><local:HelpMark Text="連続が70%以上なら「全体を順に」（カバー率90%以上）か「一部を順に」、30%未満なら「散らばる（疎）」、その間は「混在」。読み込みが3回以下なら「数回だけ」。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Read}" SortMemberPath="ReadBytes" Width="105"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="読み取り量"/><local:HelpMark Text="アプリが読み取った量の合計。同じ場所を何度も読めば、そのたびに数えます。&#10;読み取り量 = 再読み取り量 + 読み取り範囲。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Repeat}" SortMemberPath="RepeatBytes" Width="150"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="再読み取り量"/><local:HelpMark Text="すでに一度読んだ場所をもう一度読んだ分（量と、読み取り量に対する割合）。&#10;キャッシュに残っていれば、この分はキャッシュから返っているかもしれません（Windowsのファイルキャッシュでも、LucidLinkのキャッシュでも）。1回目の読み取りは、必ずストレージから取ります。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding RangeOfSize}" SortMemberPath="CoverageValue" Width="210"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="読み取り範囲 / サイズ"/><local:HelpMark Text="読み取り範囲: ファイルの中で読み取られた部分の大きさ（重複を除く）。サイズ: アクセスの後に照会したファイルサイズか、読み書きした最も後ろの位置の大きいほう。&#10;括弧はカバー率（読み取り範囲 ÷ サイズ）。大きなファイルの一部だけを読むと低くなります。記録中に大きくなったファイルではずれます。この列はカバー率で並べ替わります。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding RequestSize}" SortMemberPath="RequestBytes" Width="120"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="読み取りサイズ"/><local:HelpMark Text="1回の読み取りの大きさ（アプリがOSに頼んだ、ReadFileなどのシステムコールの大きさ）の中央値。合計は読み取り量。&#10;「≤64 KiB」なら、半分以上の読み取りが64 KiB以下（2のべき乗で区切った上限値）。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Continuous}" SortMemberPath="ContinuousValue" Width="75"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="連続"/><local:HelpMark Text="同じファイルハンドルで、前の読み込みが終わった位置から続けて読んだ割合（1 MiB以内の前方への読み飛ばしを含む）。各ハンドルの最初の1回は含みません。&#10;低いのにカバー率が高いときは、全体を順不同で読んでいるか、複数のスレッドで分担して読んでいます（HTMLレポートのヒートマップで見分けられます）。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns></DataGrid>
          <TextBlock x:Name="PatternNote" Grid.Row="2" Text="" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#91A6C5" Margin="12,8"/></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" Height="400"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="18,14,18,10"><StackPanel Orientation="Horizontal"><TextBlock Text="ファイルごとの書き方" FontWeight="SemiBold"/><local:HelpMark Text="アプリの書き込み（ページングI/Oを除く）を、ファイルごとにまとめた一覧です。書き込み量の多い順に最大1,000件。&#10;記録の開始時点のサイズは推定です（アクセスの後に照会したサイズと、書き換えられる前に読まれた位置から）。"/></StackPanel><TextBlock x:Name="WriteShapeSummary" Text="" Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          <DataGrid x:Name="WriteGrid" Grid.Row="1"><DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Shape}" Width="140"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="型"/><local:HelpMark Text="開始時にデータが無かったファイルは「新規に順に書く」か「新規（順不同）」（連続が70%以上かどうか）。&#10;既存の上書きが無ければ「末尾に追記」。重複を除いた書き込みの9割以上が既存の上書きなら「既存を順に上書き」か「既存の一部を上書き」。&#10;その他は「混在」、書き込みが3回以下なら「数回だけ」。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Write}" SortMemberPath="WriteBytes" Width="105"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="書き込み量"/><local:HelpMark Text="アプリが書き込んだ量の合計。同じ場所を何度も書けば、そのたびに数えます。&#10;書き込み量 = 再書き込み量 + 既存の上書き + 新しい部分。書いたバイトは、必ずこの3つのどれかに入ります。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Rewrite}" SortMemberPath="RewriteBytes" Width="140"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="再書き込み量"/><local:HelpMark Text="すでに一度書いた場所をもう一度書いた分（量と、書き込み量に対する割合）。&#10;LucidLinkのように書き込みをいったんローカルに置いて後からアップロードするストレージでは、アップロードの前にまとめられれば、この分だけアップロードが減り得ます。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Overwrite}" SortMemberPath="OverwriteBytes" Width="220"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="既存の上書き / 開始時のサイズ"/><local:HelpMark Text="既存の上書き: 記録の開始時点で既にあったデータへの書き込み（1回目の分。重複を除く）。開始時のサイズは推定です。括弧は、開始時のデータのうち上書きした割合。&#10;分割方式のストレージでは、断片の一部だけを書き換えると、その断片の残りの内容が必要になります（キャッシュに無ければ取りに行きます）。記録中に作られたファイルは「新規」。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding NewPart}" SortMemberPath="NewBytes" Width="110"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="新しい部分"/><local:HelpMark Text="開始時のサイズより後ろへの書き込み（末尾への追記や、新規ファイルの中身。1回目の分）。&#10;新しい断片としてそのままアップロードされる分です。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding WriteSize}" SortMemberPath="WriteSizeBytes" Width="120"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="書き込みサイズ"/><local:HelpMark Text="1回の書き込みの大きさの中央値（2のべき乗で区切った上限値）。合計は書き込み量。&#10;断片の境界をまたぐ書き込みは、複数の断片を書き換えます（例: 256 KiB単位で300 KiBを書くと2〜3個）。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Continuous}" SortMemberPath="ContinuousValue" Width="75"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="連続"/><local:HelpMark Text="同じファイルハンドルで、前の書き込みが終わった位置から続けて書いた割合（1 MiB以内の前方への読み飛ばしを含む）。各ハンドルの最初の1回は含みません。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns></DataGrid></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="18,14,18,10"><TextBlock Text="分割単位ごとの取得量の試算（LucidLinkなど）" FontWeight="SemiBold"/><local:HelpMark Text="LucidLinkのように、ファイルを同じ大きさの断片（チャンク）に分けて保存し、読まれた位置を含む断片を取りに行くストレージを想定した試算です。&#10;キャッシュが空・先読みなし・一度取った断片は取り直さない、という前提の下限値で、実際の転送量や待ち時間の予測ではありません。分割単位の候補を比べる材料として使います。&#10;ファイルごとの取得量は access-patterns.csv にあります。"/></StackPanel>
          <DataGrid x:Name="ChunkGrid" Height="200" CanUserSortColumns="False"><DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Unit}" Width="*"><DataGridTextColumn.Header><StackPanel><TextBlock Text=" " FontSize="10"/><StackPanel Orientation="Horizontal"><TextBlock Text="分割単位"/><local:HelpMark Text="想定する断片（チャンク）の大きさ。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding ReadChunks}" Width="110"><DataGridTextColumn.Header><StackPanel><TextBlock Text="読み込み" FontSize="10" Foreground="#74A8FF"/><StackPanel Orientation="Horizontal"><TextBlock Text="取得回数"/><local:HelpMark Text="記録の読み込みのために取りに行く断片の数。キャッシュが空のときのキャッシュミスの回数にあたり、1回ごとにクラウドとの往復の待ちが発生します（並列接続や先読みで一部は隠れます）。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding ReadBytes}" Width="110"><DataGridTextColumn.Header><StackPanel><TextBlock Text="読み込み" FontSize="10" Foreground="#74A8FF"/><StackPanel Orientation="Horizontal"><TextBlock Text="取得量"/><local:HelpMark Text="取りに行く断片の合計の大きさ。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding ReadEfficiency}" Width="100"><DataGridTextColumn.Header><StackPanel><TextBlock Text="読み込み" FontSize="10" Foreground="#74A8FF"/><StackPanel Orientation="Horizontal"><TextBlock Text="効率"/><local:HelpMark Text="読んだ範囲（重複を除く）÷ 取得量。100%なら無駄なし。&#10;散らばった小さな読み込みが多いほど低くなります（例: 4 KiBずつ離れた位置を読むと、256 KiB単位では1.6%）。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding WriteChunks}" Width="120"><DataGridTextColumn.Header><StackPanel><TextBlock Text="書き込み" FontSize="10" Foreground="#65DDC8"/><StackPanel Orientation="Horizontal"><TextBlock Text="更新回数"/><local:HelpMark Text="書き込みで中身が変わる断片の数。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding WriteBytes}" Width="175"><DataGridTextColumn.Header><StackPanel><TextBlock Text="書き込み" FontSize="10" Foreground="#65DDC8"/><StackPanel Orientation="Horizontal"><TextBlock Text="アップロード量（下限）"/><local:HelpMark Text="記録全体を通して、同じ断片を1回だけ送れた場合（書き込みがアップロードの前にすべてまとめられた場合）の量。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding WriteEachBytes}" Width="175"><DataGridTextColumn.Header><StackPanel><TextBlock Text="書き込み" FontSize="10" Foreground="#65DDC8"/><StackPanel Orientation="Horizontal"><TextBlock Text="アップロード量（上限）"/><local:HelpMark Text="書き込みのたびに、触れた断片を送る場合（まとめられない場合）の量。&#10;実際は下限と上限の間で、書き込みキャッシュがアップロードの前にどれだけまとめるかで決まります。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding WriteEfficiency}" Width="90"><DataGridTextColumn.Header><StackPanel><TextBlock Text="書き込み" FontSize="10" Foreground="#65DDC8"/><StackPanel Orientation="Horizontal"><TextBlock Text="効率"/><local:HelpMark Text="書き込み範囲（重複を除く）÷ アップロード量（下限）。小さな上書きが多いほど低くなります。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding WritePartial}" Width="115"><DataGridTextColumn.Header><StackPanel><TextBlock Text="書き込み" FontSize="10" Foreground="#65DDC8"/><StackPanel Orientation="Horizontal"><TextBlock Text="一部書き換え"/><local:HelpMark Text="記録の開始時点にあったデータの断片のうち、書き込みが一部しか覆わないものの数。&#10;アップロードの前に断片の残りの内容が必要で、キャッシュに無ければ取りに行きます（この取得は「読み込み：取得量」に含みません）。"/></StackPanel></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns></DataGrid>
        </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>

      <Grid x:Name="ReplayPanel" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="再生の設定" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="選択中の記録" Style="{StaticResource Caption}"/><TextBlock x:Name="ReplaySessionText" Text="先に「記録を開く」で記録を選択してください。" TextWrapping="Wrap" Foreground="#B7C8E0"/>
          <TextBlock Text="試験先フォルダ（ダミーを置く場所: NAS・LucidLinkなど）" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="選択…" Padding="10,8" Margin="6,0,0,0" Click="BrowseTarget"/><TextBox x:Name="TargetBox" Tag="例: L:\Bench"/></DockPanel>
          <TextBlock Text="試験ごとに、この中へ日時付きのフォルダを作ってダミーを置きます。" TextWrapping="Wrap" FontSize="11" Foreground="#8498B8" Margin="0,6,0,0"/>
          <TextBlock Text="乱数シード（ダミーの中身）" Style="{StaticResource Caption}"/><TextBox x:Name="SeedBox" Text="42" Tag="空欄なら 42" ToolTip="数字でも文字列でも指定できます。同じ値なら、毎回同じ中身のダミーになります。"/>
          <TextBlock Text="再生する範囲" Style="{StaticResource Caption}"/><ComboBox x:Name="ReplayScope" SelectedIndex="0"><ComboBoxItem Content="記録した全ファイルI/O"/><ComboBoxItem Content="指定プロセスに一致したI/Oのみ"/><ComboBoxItem Content="指定フォルダに一致したI/Oのみ"/></ComboBox>
          <TextBlock Text="ダミーは、この範囲の再生が使うファイルだけ作ります。範囲を変えたときは、ダミーを生成し直します。" TextWrapping="Wrap" FontSize="11" Foreground="#8498B8" Margin="0,6,0,0"/>
          <TextBlock Text="場所" Style="{StaticResource Caption}"/><TextBlock x:Name="ReplayLocationText" Text="すべての場所" TextWrapping="Wrap" Foreground="#B7C8E0" ToolTip="02の「場所で絞り込む…」で選んだフォルダの中のI/Oだけで、ダミーを作って再生します。"/>
          <Button x:Name="GenerateButton" Content="1. ダミーファイルを生成" Style="{StaticResource Primary}" Click="GenerateDataset" Margin="0,18,0,0"/>
          <TextBlock Text="生成完了後、LucidLinkのアップロード完了を確認し、試験条件に合わせてキャッシュを整えます。" TextWrapping="Wrap" FontSize="12" Foreground="#91A6C5" Margin="0,12,0,6"/>
          <TextBlock Text="タイミング" Style="{StaticResource Caption}"/><ComboBox x:Name="TimingBox" SelectedIndex="0"><ComboBoxItem Tag="ThinkTime" Content="完了を待ち、記録と同じ間隔で次を出す（ThinkTime）"/><ComboBoxItem Tag="Timeline" Content="記録の時刻どおりに出す（Timeline）"/></ComboBox>
          <TextBlock Text="ThinkTime: 作業時間の比較向け。試験先が遅ければ全体が伸び、速ければ縮みます。&#10;Timeline: 同じ負荷での遅延比較向け。遅れても記録の時刻に追いつこうとします。" TextWrapping="Wrap" FontSize="11" Foreground="#8498B8" Margin="0,6,0,0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="速度倍率" Style="{StaticResource Caption}"/><TextBox x:Name="SpeedBox" Text="1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="最大並列数" Style="{StaticResource Caption}"/><TextBox x:Name="WorkersBox" Text="8"/></StackPanel></Grid>
          
          <CheckBox x:Name="RecordReplayBox" IsChecked="True" Content="再生中のI/Oも記録する（05で元の記録と比較）" ToolTip="再生の間、ダミーのフォルダへの全プロセスのI/OをETWで記録し、元の記録フォルダの replays に保存します。管理者権限で起動したときだけ使えます。"/>
          <Button x:Name="ReplayButton" Content="2. リプレイを開始" Style="{StaticResource Primary}" Click="RunReplay" Margin="0,12,0,0"/>
          <Button x:Name="ReplayResetButton" Content="ダミーを初期状態に戻す" IsEnabled="False" Click="ReplayReset" Margin="0,8,0,0" ToolTip="再生で作られたファイルを消し、書き換えられた部分だけを元の内容に戻します。同じダミーでもう一度再生できます。"/>
          <Button x:Name="CancelReplayButton" Content="処理を中止" Click="StopWork" IsEnabled="False" Margin="0,8,0,0"/>
        </StackPanel></ScrollViewer></Border>
        <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="再生の結果" FontSize="17" FontWeight="SemiBold"/><local:HelpMark Text="実行: 再生したI/Oの数。失敗: 再生で失敗した数（記録では成功した操作）。スキップ: 再生しなかった数（記録で失敗した操作、キャッシュ補充などのページングI/O、対象外のパスなど。内訳は replay-*.jsonl の status）。&#10;P95 / P99: 再生したRead・Writeの所要時間（再生側で測定）。&#10;投入の遅れ: 各I/Oを予定よりどれだけ遅く出したか。ThinkTimeは記録の間隔、Timelineは記録の時刻が基準。小さければ、記録どおりのペースで再生できています。"/></StackPanel><TextBlock x:Name="ReplayResultText" Text="ダミーファイルを生成して、再生を開始してください。" TextWrapping="Wrap" Foreground="#C8D5E9" Margin="0,18,0,0" FontSize="15" LineHeight="28"/><Button x:Name="CompareReplayButton" Content="05で元の記録と比べる" Visibility="Collapsed" HorizontalAlignment="Left" Padding="14,8" Margin="0,14,0,0" Click="CompareLastReplay"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="この試験で分かること" FontWeight="SemiBold"/><TextBlock Text="• Read / Writeの位置・サイズ・投入間隔&#10;• ファイル作成・EOF変更・Flush等の負荷&#10;• 再生先のI/O遅延とスケジュールの遅れ" TextWrapping="Wrap" Foreground="#A6B9D5" LineHeight="27" Margin="0,12,0,0"/><TextBlock Text="ダミーは圧縮されにくい乱数です。初期サイズ・列挙結果・アクセス権等は近似を含みます。未解決のRenameや未対応操作は結果にスキップとして残します。" TextWrapping="Wrap" Foreground="#91A6C5" LineHeight="24" Margin="0,14,0,0"/><TextBlock Text="再生するとダミーの中身が変わります。もう一度同じ条件で再生するときは「ダミーを初期状態に戻す」を押します（書き換わった部分だけを戻すので、作り直すより速く済みます）。再生の結果は、記録のフォルダに保存します。" TextWrapping="Wrap" Foreground="#65DDC8" LineHeight="24" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
      </Grid>
      <Grid x:Name="BenchPanel" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="ベンチマークの設定" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="構成ファイル（JSON）" Style="{StaticResource Caption}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="参照…" Padding="10,8" Margin="6,0,0,0" Click="BrowseBenchConfig"/><TextBox x:Name="BenchConfigBox"/></DockPanel>
          <WrapPanel Margin="0,6,0,0"><Button Content="サンプルを使う" Padding="10,7" Click="UseBenchSample"/><Button Content="構成を開いて編集" Padding="10,7" Margin="6,0,0,0" Click="EditBenchConfig"/></WrapPanel>
          <TextBlock Text="seed" Style="{StaticResource Caption}"/><TextBox x:Name="BenchSeedBox" Tag="空欄なら構成ファイルの seed（数字・文字列どちらも可）" ToolTip="構成ファイルとseedが同じなら、毎回同じI/O列になります。数字でも文字列（例: LucidLink試験A）でも指定できます。"/>
          <TextBlock Text="レポートの保存先" Style="{StaticResource Caption}"/><TextBlock x:Name="BenchDestination" TextWrapping="Wrap" FontSize="12" Foreground="#B7C8E0"/>
          <TextBlock Text="試験先フォルダ（ダミーを置く場所: NAS・LucidLinkなど）" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="選択…" Padding="10,8" Margin="6,0,0,0" Click="BrowseBenchTarget"/><TextBox x:Name="BenchTargetBox" Tag="例: L:\Bench"/></DockPanel>
          <TextBlock Text="試験ごとに、この中へ日時付きのフォルダを作ってダミーを置きます。" TextWrapping="Wrap" FontSize="11" Foreground="#8498B8" Margin="0,6,0,0"/>
          <Button x:Name="BenchGenerateButton" Content="1. ダミーファイルを生成" Style="{StaticResource Primary}" Click="BenchGenerate" Margin="0,18,0,0"/>
          <TextBlock Text="LucidLinkなら、アップロードの完了を確認し、キャッシュ条件（Cold / Warm / Pin）を整えてから実行します。" TextWrapping="Wrap" FontSize="12" Foreground="#91A6C5" Margin="0,10,0,4"/>
          <Button x:Name="BenchRunButton" Content="2. ベンチマークを実行" Style="{StaticResource Primary}" Click="BenchRun" Margin="0,4,0,0"/>
          <Button x:Name="BenchResetButton" Content="ダミーを初期状態に戻す" IsEnabled="False" Click="BenchReset" Margin="0,8,0,0" ToolTip="実行で作られたファイルを消し、書き換えられた部分だけを元の内容に戻します。同じダミーでもう一度実行できます。"/>
          <Button x:Name="BenchCancelButton" Content="■  中止" IsEnabled="False" Background="#4D2836" BorderBrush="#7C4051" Click="StopWork" Margin="0,8,0,0"/>
        </StackPanel></ScrollViewer></Border>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel>
            <Grid><TextBlock Text="進行状況" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BenchSteps" Text="1 生成  ›  2 実行" Foreground="#91A6C5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,16,0,8"><TextBlock x:Name="BenchStage" Text="構成ファイルと試験先を選び、ダミーファイルを生成してください。" FontSize="15"/><TextBlock x:Name="BenchPercent" Text="" FontSize="15" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="#65DDC8"/></Grid>
            <ProgressBar x:Name="BenchProgress" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="BenchDetail" Text="" TextWrapping="Wrap" Foreground="#A6B9D5" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock x:Name="BenchPaths" Text="" TextWrapping="Wrap" Foreground="#7E91AF" FontSize="11" Margin="0,10,0,0"/>
          </StackPanel></Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="18,14"><TextBlock Text="構成の概要" FontWeight="SemiBold"/><TextBlock x:Name="BenchConfigSummary" Text="" Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right"/></Grid>
            <DataGrid x:Name="BenchWorkloadsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="負荷" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="比率" Binding="{Binding Share}" Width="60"/><DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="150"/><DataGridTextColumn Header="ファイル群" Binding="{Binding Files}" Width="170"/><DataGridTextColumn Header="予定量" Binding="{Binding Planned}" Width="90"/></DataGrid.Columns></DataGrid>
          </Grid></Border>
          <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="18,14"><TextBlock Text="結果" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="BenchTotal" Text="" Foreground="#65DDC8" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="BenchReportButton" Content="レポートを開く" Padding="10,5" IsEnabled="False" Click="OpenBenchReport"/><Button Content="フォルダを開く" Padding="10,5" Margin="6,0,0,0" Click="OpenBenchFolder"/></StackPanel></Grid>
            <DataGrid x:Name="BenchResultsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="負荷" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="MiB/s" Binding="{Binding MiBps,StringFormat=N1}" Width="80"/><DataGridTextColumn Header="IOPS" Binding="{Binding Iops,StringFormat=N0}" Width="80"/><DataGridTextColumn Header="P50 ms" Binding="{Binding P50Ms,StringFormat=N2}" Width="75"/><DataGridTextColumn Header="P95 ms" Binding="{Binding P95Ms,StringFormat=N2}" Width="75"/><DataGridTextColumn Header="P99 ms" Binding="{Binding P99Ms,StringFormat=N2}" Width="75"/><DataGridTextColumn Header="失敗" Binding="{Binding Failed,StringFormat=N0}" Width="60"/></DataGrid.Columns></DataGrid>
          </Grid></Border>
        </Grid>
      </Grid>
      <Grid x:Name="ComparePanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="比べる再生" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
          <ComboBox x:Name="CompareRunBox" Grid.Column="1" DisplayMemberPath="Title" SelectionChanged="CompareRunChanged"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,8,0"><TextBlock Text="比べる範囲" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><local:HelpMark Text="全体: 両方の記録を、記録されたまま（すべてのプロセスのI/O）比べます。&#10;再生した要求だけ: 元の記録のうち再生の対象にしたI/Oと、再生の記録のうち再生したプロセスが出したI/Oを比べます。再生中に試験先のOSやほかのプログラム（キャッシュの書き出し・ウイルス対策・検索インデックスなど）が出したI/Oと、ダミーの管理ファイルは含みません。&#10;どちらの範囲でも数値は記録から計算したままで、合わせるための調整はしていません。"/></StackPanel>
          <ComboBox x:Name="CompareScopeBox" Grid.Column="3" Width="190" SelectedIndex="0" SelectionChanged="CompareScopeChanged">
            <ComboBoxItem Content="全体（すべてのプロセス）" Tag="All"/>
            <ComboBoxItem Content="再生した要求だけ" Tag="Replayed"/>
          </ComboBox>
          <Button Grid.Column="4" Content="再生の記録を02で開く" Click="OpenCompareTrace" Margin="8,0,0,0" ToolTip="再生の記録を、普通の記録と同じように02で開きます（HTMLレポート・読み方・書き方なども見られます）"/>
        </Grid>
        <ScrollViewer x:Name="CompareScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock x:Name="CompareSummary" Text="「記録を開く」で記録を開いてから、このページを開いてください。" TextWrapping="Wrap" FontSize="15"/><TextBlock x:Name="CompareNote" Text="" TextWrapping="Wrap" Foreground="#91A6C5" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,14,18,10"><TextBlock Text="数値の比較" FontWeight="SemiBold"/><local:HelpMark Text="元の記録と、その再生の記録を、同じ測り方（ETWでファイルシステムに届いたI/O）で比べます。レイテンシも同じ位置で測るので、ストレージの違いをそのまま比べられます。&#10;平均は「I/Oがあった時間」（最初のI/Oから最後のI/Oまで）で割った値です。差は「再生 − 元」で、括弧は元に対する増減の割合です。&#10;「全体」では、再生の記録にダミーのフォルダに触れた全プロセスのI/O（OSのキャッシュ補充・遅延書き込み、ウイルス対策の検査など）が入ります。再生した分だけを比べるときは「比べる範囲」を「再生した要求だけ」にします。&#10;高速I/Oの拒否: フィルタードライバーが高速な経路を断り、すぐ同じ要求が出し直されたものです。1つの要求が2回記録されるので、回数や失敗には数えず、件数だけ出しています。"/></StackPanel>
            <DataGrid x:Name="CompareValuesGrid" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="項目" Binding="{Binding Item}" Width="*"/><DataGridTextColumn Header="元" Binding="{Binding Original}" Width="170"/><DataGridTextColumn Header="再生" Binding="{Binding Replay}" Width="170"/><DataGridTextColumn Header="差（再生 − 元）" Binding="{Binding Difference}" Width="200"/></DataGrid.Columns></DataGrid>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0" Height="520"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="時間ごとの推移" FontWeight="SemiBold"/><local:HelpMark Text="元を実線、再生を点線で重ねています。どちらも最初のI/Oを0秒にそろえています。&#10;ThinkTimeで再生すると、試験先の速さに応じて再生の長さが伸び縮みするので、線はぴったり重なりません。カーソルを重ねると、その秒の値を「元 / 再生」で出します。"/></StackPanel><TextBlock Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right"><Run Text="●" Foreground="#74A8FF"/><Run Text=" Read     "/><Run Text="●" Foreground="#65DDC8"/><Run Text=" Write     ／ 実線: 元・点線: 再生（最初のI/Oから）"/></TextBlock></Grid><local:GraphControl x:Name="CompareGraph" Grid.Row="1" Margin="0,12,0,0" EmptyText="比べる再生を選ぶとグラフを表示します"/></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" Height="460"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="18,14,18,10"><StackPanel Orientation="Horizontal"><TextBlock Text="ファイルごとの比較" FontWeight="SemiBold"/><local:HelpMark Text="再生の記録のダミー側のパスを、元のパスに読み替えて突き合わせています。&#10;状態: 両方にある / 元のみ（再生されなかった） / 再生のみ（元に無いのに再生で触れた）。量の多い順に並びます。"/></StackPanel><TextBlock x:Name="CompareFilesSummary" Text="" Foreground="#91A6C5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <DataGrid x:Name="CompareFilesGrid" Grid.Row="1"><DataGrid.Columns>
              <DataGridTextColumn Header="状態" Binding="{Binding Presence}" Width="85"/>
              <DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              <DataGridTextColumn Header="読み取り量（元 / 再生）" Binding="{Binding Read}" SortMemberPath="ReadBytes" Width="190"/>
              <DataGridTextColumn Header="書き込み量（元 / 再生）" Binding="{Binding Write}" SortMemberPath="WriteBytes" Width="190"/>
              <DataGridTextColumn Binding="{Binding Latency}" SortMemberPath="ReplayP95" Width="175"><DataGridTextColumn.Header><StackPanel Orientation="Horizontal"><TextBlock Text="P95（元 / 再生）"/><local:HelpMark Text="そのファイルの成功したRead・Writeのレイテンシ（P95、ms）。ページングI/Oは含みません。"/></StackPanel></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn Header="P95の差" Binding="{Binding LatencyChange}" SortMemberPath="LatencyDelta" Width="120"/>
            </DataGrid.Columns></DataGrid></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,14,18,10"><TextBlock Text="操作の件数" FontWeight="SemiBold"/><local:HelpMark Text="記録された操作の件数を、元と再生で比べます（高速I/Oの拒否は数えません）。&#10;「Read」「Write」はアプリの要求です。「Read（ページングI/O）」「Write（ページングI/O）」は、OSが自分で行うキャッシュへの読み込みと書き戻しで、データがすでにキャッシュにあるか、いつ書き戻すかで大きく変わります（再生の忠実さとは別の話です）。&#10;再生では、記録で失敗した要求のうちダミーでも同じ形で届くもの（無い名前の確認、末尾より先の読み取り、一覧の終わり、属性の問い合わせなど）は出し直し、それ以外の失敗（ロック・権限・容量不足など）や対応していない操作（FsControl・一部のSetInfo）は出しません。理由は再生結果の replay-*.jsonl の status にあります。&#10;開いた記録がないファイルへの要求は、その要求のためだけに開いて閉じるので、その分 Open・Close が増えます（再生結果の「一時的に開いた回数」）。&#10;フォルダの変更通知の要求（DirectoryNotify）は記録しますが、再生しません。&#10;再生側の Open・Cleanup・Close・QueryInfo・FsControl には、再生したプロセスの中でWindowsやウイルス対策ソフトが行った分（開くときの検査など）も入るので、「再生した要求だけ」でも元より多くなることがあります。&#10;「全体」で再生のほうが多い操作には、OSやほかのプログラム（ウイルス対策など）が再生中のダミーに触れた分が含まれます。"/></StackPanel>
            <DataGrid x:Name="CompareOpsGrid" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="*"/><DataGridTextColumn Header="元" Binding="{Binding Original}" Width="150"/><DataGridTextColumn Header="再生" Binding="{Binding Replay}" Width="150"/><DataGridTextColumn Header="差（再生 − 元）" Binding="{Binding Difference}" Width="180"/></DataGrid.Columns></DataGrid>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,14,18,10"><TextBlock Text="プロセスごとの件数" FontWeight="SemiBold"/><local:HelpMark Text="誰がI/Oを出したかを、元と再生で並べます（「比べる範囲」に関係なく、記録されたすべてのプロセス。02で場所を絞り込んでいるときは、その中のI/Oだけ）。&#10;「（再生）」の付いた行が再生したプロセスです。再生では、元でどのプロセスが出した要求も、このプロセスがまとめて出します。&#10;それ以外の行の再生側は、再生中に試験先のOSやほかのプログラムが自分で出したI/Oです。元の記録にある同じ名前のプロセスの分は再生プロセスが出し直しているので、両方に現れると二重になります。&#10;読み取り量・書き込み量はアプリの要求（ページングI/Oを除く成功したRead・Write）です。"/></StackPanel>
            <DataGrid x:Name="CompareProcessGrid" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="プロセス" Binding="{Binding Process}" Width="*"/><DataGridTextColumn Header="操作（元）" Binding="{Binding OriginalOperations}" Width="110"/><DataGridTextColumn Header="操作（再生）" Binding="{Binding ReplayOperations}" Width="110"/><DataGridTextColumn Header="読み取り量（元 / 再生）" Binding="{Binding Read}" Width="200"/><DataGridTextColumn Header="書き込み量（元 / 再生）" Binding="{Binding Write}" Width="200"/></DataGrid.Columns></DataGrid>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#27354B" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><TextBlock x:Name="LogText" Text="準備完了。計測前に対象プロセスまたはフォルダを設定してください。" Foreground="#95A8C7" TextTrimming="CharacterEllipsis"/></Border>
    </Grid>
  </Grid>
</Window>
